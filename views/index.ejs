<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>

    <!-- w- means width and h- means height and m- means margin 
    and p- means padding and block means display block and 
    rounded means border radius and bg- means background 
    color -->
    <div class="main w-full min-h-screen bg-zinc-900">
        <div  class="form p-10">
            <form action="/create" method="POST">
                <input  class="w-full px-3 py-3 block rounded bg-white"  type="text" placeholder="type title here" name="title">
                <textarea class="w-full px-3 py-3 mt-2 block rounded bg-white" placeholder="give task details" name="details"></textarea>
                <input class="px-100 py-3 mt-3 block rounded bg-blue-500 text-white" type="submit" name="sub">
            </form>
        </div>

        <div  class="tasks  w-250 rounded flex m-10">


            <%if(files.length > 0) {%>
             
                <% files.forEach((val)=>{%>
                <div class="task  px-2 py-3 rounded w-70 h-50 bg-gray-600 m-2">
                <h1 class="text-white text-xl tracking-tight"><%= val%></h1>
                <!-- <p><%= val.details%></p> -->
                <a href="/files/<%= val %>" class="text-blue-500  py-10">Read more</a>
            </div>
            <%    })%>

            <%}  else{  %>
                <h3 class="text text-zinc-300">No tasks yet</h3>
            <%}%>

        
        </div>
    </div>
</body>
</html>