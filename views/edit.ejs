<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900">
        <div  class="form p-10">
            <form action="/edit" method="POST">
                <input  class="w-1/3 px-3 py-3 block rounded bg-white "  type="text" placeholder="<%= filename %>" name="old" value="<%= filename%>" readonly>
                <textarea class="w-1/3 px-3 py-3 mt-2 block rounded bg-white" placeholder="Enter the new title" name="new" ></textarea>
                <input class="px-100 py-3 mt-3 block rounded bg-blue-500 text-white" type="submit" name="sub">
            </form>
        </div>
    </div>

</body>
</html>